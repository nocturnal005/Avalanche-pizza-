# Avalanche Pizza — environment
#
# Copy to .env.local for development. In production these live in Vercel's
# encrypted environment variables. NOTHING SECRET may be prefixed NEXT_PUBLIC_.

# Canonical origin. Production only; preview and local fall back automatically.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Flutterwave (ADR-010). Absent = the site runs in mocked-payment mode and no
# money can move, which is the safe default.
#
# Get these from the Flutterwave dashboard: Settings -> API Keys.
# Use TEST keys (FLWSECK_TEST-...) until the live drill.
# ---------------------------------------------------------------------------

# Secret key. Server-only — never expose, never commit a real value.
FLUTTERWAVE_SECRET_KEY=

# The "Secret hash" you set under Settings -> Webhooks. Flutterwave signs each
# webhook with HMAC-SHA256 using this value; without it every webhook is
# rejected, which is correct — an unverified webhook must never mark an order
# paid.
FLUTTERWAVE_SECRET_HASH=
